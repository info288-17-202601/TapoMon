# ──────────────────────────────────────────────────────
#  server/.env.example
#  Copy to .env and fill in production values.
#  Loaded automatically by server/config.py via python-dotenv.
# ──────────────────────────────────────────────────────

# MongoDB (set to the service name when running in docker-compose)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=Tapomon

# FastAPI server bind
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# JWT — CHANGE THIS in production!
JWT_SECRET=tapomon-dev-secret-change-in-prod
JWT_EXPIRATION_HOURS=24

# Idle simulation tick interval (seconds)
IDLE_TICK_INTERVAL=60

# Independencia mechanic tuning (optional overrides)
INDEPENDENCIA_GROWTH=1
INDEPENDENCIA_HEALTH_THRESHOLD=60
SELF_FEED_HAMBRE=25
SELF_PLAY_FELICIDAD=20
SELF_PLAY_ENERGIA=-10
SELF_PLAY_ENERGIA_MIN=15
SELF_TRAIN_STAT=1
